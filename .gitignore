# Secrets: never commit the real .env (only the placeholder file)
.env
.env.*
!.env.example

# Python / Node installs
.venv/
__pycache__/
*.pyc
node_modules/
frontend/dist/
frontend/node_modules/.tmp/

# Runtime leftovers (the real output/audit_trail.json IS committed)
output/*.tmp
output/audit_trail.broken-*.json
output/mcp_server.log
*.db-journal
*.db-wal
*.db-shm

# OS / editor
.DS_Store
.vscode/
.idea/

